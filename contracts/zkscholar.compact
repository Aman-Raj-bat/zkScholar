pragma language_version >= 0.22;

import CompactStandardLibrary;

export ledger min_cs_score: Uint<32>;
export ledger min_coding_hours: Uint<32>;
export ledger max_family_income: Uint<32>;
export ledger admin: Bytes<32>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger grant_deadline: Uint<64>;
export ledger is_active: Boolean;
export ledger max_grants: Uint<32>;
export ledger total_grants: Uint<32>;

struct ApplicantCredentials {
    cs_score: Uint<32>,
    coding_hours: Uint<32>,
    family_income: Uint<32>,
    applicant_id: Bytes<32>
}

witness applicant_credentials(): ApplicantCredentials;
witness admin_secret_key(): Bytes<32>;

constructor(initial_min_cs_score: Uint<32>, initial_min_coding_hours: Uint<32>, initial_max_family_income: Uint<32>, initial_admin: Bytes<32>, deadline: Uint<64>, grant_limit: Uint<32>) {
    min_cs_score = disclose(initial_min_cs_score);
    min_coding_hours = disclose(initial_min_coding_hours);
    max_family_income = disclose(initial_max_family_income);
    admin = disclose(initial_admin);
    grant_deadline = disclose(deadline);
    max_grants = disclose(grant_limit);
    is_active = disclose(true);
    total_grants = disclose(0);
}

export circuit apply_for_grant(): [] {
    // TODO: assertions
}
