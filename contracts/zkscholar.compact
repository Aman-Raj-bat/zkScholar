pragma language_version >= 0.22;

import CompactStandardLibrary;

// =============================================================================
// zkScholar - Privacy-Preserving Tech Grant Verification
// Ledger State (Public, on-chain)
// =============================================================================
export ledger min_cs_score: Uint<32>;
export ledger min_coding_hours: Uint<32>;
export ledger max_family_income: Uint<32>;
export ledger admin: Bytes<32>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger grant_deadline: Uint<64>;
export ledger is_active: Boolean;
export ledger max_grants: Uint<32>;
export ledger total_grants: Uint<32>;

// =============================================================================
// Private Witnesses (never revealed on-chain)
// =============================================================================
struct ApplicantCredentials {
    cs_score: Uint<32>,
    coding_hours: Uint<32>,
    family_income: Uint<32>,
    applicant_id: Bytes<32>
}
witness applicant_credentials(): ApplicantCredentials;
witness admin_secret_key(): Bytes<32>;

// =============================================================================
// Constructor - Called ONCE at deploy time
// =============================================================================
constructor(
    initial_min_cs_score: Uint<32>,
    initial_min_coding_hours: Uint<32>,
    initial_max_family_income: Uint<32>,
    initial_admin: Bytes<32>,
    deadline: Uint<64>,
    grant_limit: Uint<32>
) {
    min_cs_score = disclose(initial_min_cs_score);
    min_coding_hours = disclose(initial_min_coding_hours);
    max_family_income = disclose(initial_max_family_income);
    admin = disclose(initial_admin);
    grant_deadline = disclose(deadline);
    max_grants = disclose(grant_limit);
    is_active = disclose(true);
    total_grants = disclose(0);
}

// =============================================================================
// Core Circuits
// =============================================================================
export circuit apply_for_grant(): [] {
    assert(disclose(is_active), "Grant applications are currently paused");
    assert(blockTimeLt(disclose(grant_deadline)), "Application deadline has passed");
    assert(disclose(total_grants) < disclose(max_grants), "Grant cap has been reached");
    const creds = applicant_credentials();
    assert(creds.cs_score > 0, "CS score must be greater than 0");
    assert(creds.coding_hours > 0, "Coding hours must be greater than 0");
    assert(creds.family_income > 0, "Family income must be greater than 0");
    assert(creds.cs_score >= min_cs_score, "CS score below minimum threshold");
    assert(creds.coding_hours >= min_coding_hours, "Coding hours below minimum threshold");
    assert(creds.family_income <= max_family_income, "Family income exceeds maximum threshold");
    const nul = makeNullifier(creds.applicant_id);
    assert(!nullifiers.member(disclose(nul)), "This applicant has already received a grant");
    nullifiers.insert(disclose(nul));
    total_grants = disclose((total_grants + 1) as Uint<32>);
}

export circuit update_grant_config(
    new_min_cs_score: Uint<32>,
    new_min_coding_hours: Uint<32>,
    new_max_family_income: Uint<32>,
    new_deadline: Uint<64>,
    new_max_grants: Uint<32>,
    new_active_status: Boolean
): [] {
    const sk = admin_secret_key();
    assert(admin == adminPublicKey(sk), "Not authorized: invalid admin key");
    min_cs_score = disclose(new_min_cs_score);
    min_coding_hours = disclose(new_min_coding_hours);
    max_family_income = disclose(new_max_family_income);
    grant_deadline = disclose(new_deadline);
    max_grants = disclose(new_max_grants);
    is_active = disclose(new_active_status);
}

// =============================================================================
// Pure Circuits (deterministic helpers)
// =============================================================================
export pure circuit adminPublicKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkscholar:admin:v1"), sk]);
}

export pure circuit makeNullifier(applicant_id: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkscholar:nullifier:v1"), applicant_id]);
}

// v1.0 nullifier-based double-claim prevention
// v1.1 adminPublicKey and makeNullifier pure circuits
